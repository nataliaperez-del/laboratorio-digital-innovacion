# Copia este archivo a .env.local (recomendado) o .env en la raíz del proyecto.
# Esos archivos están en .gitignore: no se suben al repositorio.
#
# Google OAuth (solo lectura Drive) — Fase 2 · Contenedor 1: leer PDF, DOCX, Google Docs e imágenes (OCR).
# Cliente OAuth "Aplicación web", API Google Drive habilitada, origen http://localhost:3000 autorizado.
# Obligatorio el prefijo VITE_ y reiniciar "npm run dev" tras guardar .env.local
VITE_GOOGLE_CLIENT_ID=

# ── Ingreso institucional (pantalla de inicio de sesión) ──
# Dominios de correo aceptados para ingresar, separados por coma. Por defecto: unad.edu.co
# VITE_ALLOWED_EMAIL_DOMAINS=unad.edu.co
# Minutos de inactividad antes de cerrar la sesión automáticamente (5–720; por defecto 30).
# VITE_SESSION_IDLE_MINUTES=30
# SOLO DESARROLLO: desactiva la pantalla de ingreso (nunca usar en producción).
# VITE_AUTH_DISABLED=true

# Opcional: ID de la carpeta institucional de Google Drive (Fases 2 y 3).
# Es la parte final del enlace https://drive.google.com/drive/folders/<ID>.
# Si no se define, se usa la carpeta oficial del CIP configurada en el código.
# VITE_DRIVE_FOLDER_ID=1fWqgAlPTjjDi_ZLb6CfU0sFLG7bOKZ5g

# Opcional: tope de caracteres del texto de Drive que se envían al modelo (por defecto 900000; máx. 2000000).
# Si es muy bajo, puede cortarse antes de incluir prompts embebidos (p. ej. prompt_arbol_innovacion.txt); Fase 3 intenta descargar ese archivo aparte.
# VITE_MAX_INSTITUTIONAL_CHARS=1200000
#
# Opcional: tope del TXT metodológico Contenedor 2 embebido en generateContainer (PROMPTS_FUENTES_CONSULTA_CONTENEDOR2_TERRITORIAL 1.txt; por defecto 120000).
# VITE_MAX_C2_PROMPT_DOC_CHARS=180000
#
# Opcional: tope del TXT de instrucción embebido en **cada** apartado del documento fundante (instruccion_documento_fundante_CIP_actualizada.txt; por defecto 180000).
# VITE_MAX_INSTRUCCION_FUNDANTE_CHARS=220000
#
# Opcional: tope del texto institucional de Google Drive al generar el Contenedor (Fase 2). Con UNAD el default interno es ~80000; si hay 500 del proxy, prueba 60000.
# VITE_MAX_COMBINED_SOURCE_CHARS=60000
# VITE_MAX_DOCUMENT_CONTAINER_CHARS=150000
#
# Opcional: tope del Contenedor 2 en los pasos de vocación/tema y árbol de innovación (Fase 3).
# VITE_MAX_THEME_STEP_CONTAINER_CHARS=60000
#
# Opcional: cola del documento parcial (caracteres) reenviada en cada apartado del fundante por secciones.
# VITE_MAX_FUNDANTE_PREV_CONTEXT_CHARS=12000
#
# Opcional: en Fase 3 se reenvía texto bruto de Drive (además del Contenedor 2) para documentos más densos.
# VITE_MAX_DOCUMENT_SUPPLEMENTARY_CHARS=400000
#
# Opcional: máx. de proyectos del registro SIGIIP incluidos en el prompt del apartado 6.
# VITE_MAX_SIGIIP_PROJECTS=120
#
# ── Proxy UNAD · Gemini (IA 360) — proveedor por defecto en la app (cabeceras x-api-key + Bearer).
# En local, Vite reenvía a UNAD vía /api/unad-gemini (evita CORS). En Vercel la misma ruta la atiende api/unad-gemini.ts.
# No subas credenciales al repositorio.
# VITE_UNAD_GEMINI_BASE_URL=https://chatbot-ia-360.unad.edu.co/api-proxy/v1
# VITE_UNAD_GEMINI_MODEL=gemini-2.5-flash
# VITE_UNAD_GEMINI_MODEL=gemini-2.5-flash-lite
# VITE_UNAD_GEMINI_X_API_KEY= 
# VITE_UNAD_GEMINI_BEARER=
# Opcional: el proxy UNAD a veces responde 500 con prompts largos o maxOutput muy alto (por defecto 8192).
# VITE_UNAD_GEMINI_MAX_OUTPUT_TOKENS=16384
# Opcional: tokens de "pensamiento" de gemini-2.5-* (descuentan de maxOutputTokens). Por defecto 1024:
# sin límite el pensamiento puede comerse toda la salida; con 0 el modelo degenera en prompts largos (bucles de "---").
# VITE_UNAD_GEMINI_THINKING_BUDGET=1024
#
# Opcional: modelo de Anthropic para el proveedor Claude (por defecto claude-sonnet-5).
# VITE_ANTHROPIC_MODEL=claude-sonnet-5
#
# Opcional: modelo para "Google Gemini (API directa)". Por defecto gemini-3.5-flash
# (gemini-2.5-pro está restringido a cuentas con uso previo y da 404 en proyectos nuevos).
# VITE_GEMINI_MODEL=gemini-3.5-flash
#
# Opcional: clave para "Google Gemini (API directa)" si no se ingresa desde el panel de IA de la app.
# GEMINI_API_KEY=
