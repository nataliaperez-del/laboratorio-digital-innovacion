# Copia este archivo a .env.local. Ese archivo está en .gitignore: no se sube al repositorio.
#
# ── IA institucional UNAD (Proxy IA 360) ──
# Sin prefijo VITE_: quedan solo en el servidor de desarrollo y NUNCA llegan al navegador.
# En Hostinger se definen en config/ia.php (ver hostinger_deploy/config/ia.example.php).
# UNAD_GEMINI_X_API_KEY=
# UNAD_GEMINI_BEARER=
# UNAD_GEMINI_BASE_URL=https://chatbot-ia-360.unad.edu.co/api-proxy/v1
# UNAD_GEMINI_MODEL=gemini-3.5-flash
#
# Alternativa directa a Google si no se usa el proxy institucional (también solo servidor).
# GEMINI_API_KEY=
#
# Otros proveedores (Claude, OpenAI, Gemini comercial, Ollama): se eligen en el botón «IA»
# de la cabecera, con la clave de cada persona. La clave vive solo en esa pestaña.
#
# ── Fuentes propias del territorio por Google Drive (Estudio Territorial) ──
# Cliente OAuth "Aplicación web", API de Drive habilitada, origen http://localhost:3000 autorizado.
# Sin este valor sigue funcionando la carga directa de archivos. Reinicia `npm run dev` al cambiarlo.
VITE_GOOGLE_CLIENT_ID=
#
# ── Ajustes opcionales del proxy institucional ──
# VITE_UNAD_GEMINI_MODEL=gemini-3.5-flash
# VITE_UNAD_GEMINI_MAX_OUTPUT_TOKENS=8192
# VITE_UNAD_GEMINI_THINKING_BUDGET=1024
#
# ── Límites de contexto enviados al modelo (si el proxy responde 500, redúcelos) ──
# VITE_MAX_COMBINED_SOURCE_CHARS=60000
# VITE_MAX_C2_PROMPT_DOC_CHARS=48000
# VITE_MAX_THEME_STEP_CONTAINER_CHARS=60000
