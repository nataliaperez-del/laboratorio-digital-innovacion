# ==============================================================================
# LABORATORIO DIGITAL DE INNOVACIÓN — INNOVAHUB360
# Configuración Apache / LiteSpeed para Hostinger
# ==============================================================================

Options -Indexes
ServerSignature Off

# Protección de archivos sensibles
<FilesMatch "(\.env|\.git|\.lock|composer\.json|schema.*\.sql)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Encabezados de Seguridad
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Laboratorio sin conexión: el service worker y la página se revalidan en cada visita,
# para que una versión nueva llegue apenas se publica (el resto lleva hash en el nombre).
<IfModule mod_headers.c>
    <FilesMatch "^(sw\.js|index\.html)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# Compresión Gzip para mejorar velocidad en hosting compartido
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# Caché de Assets Estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType font/woff2 "access plus 1 month"
</IfModule>

# Enrutamiento de URLs (Rewrite)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Enrutamiento para Proxy Gemini
    RewriteRule ^api/unad-gemini$ includes/gemini_proxy.php [L,QSA]

    # Lectura del Radar del Observatorio
    RewriteRule ^api/observatorio/radar$ includes/observatorio.php [L,QSA]

    # Concentrador de datos del Laboratorio (ingresos, uso, resultados e insumos de todos)
    RewriteRule ^api/lab/?(.*)$ includes/lab.php?ruta=$1 [L,QSA]

    # Enrutamiento para API REST
    RewriteRule ^api/data$ includes/api.php [L,QSA]

    # La configuración del servidor nunca se sirve por web
    RewriteRule ^config/ - [F,L]

    # SPA Routing: Si el archivo o carpeta física no existe, enviar a index.html (o index.php)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>
