{
  "name": "laboratorio-digital-innovacion",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "deploy:package": "npm run build && node scripts/empaquetar-hostinger.mjs",
    "sellar": "node scripts/sellar-repositorio.mjs",
    "zoe:banco": "node scripts/zoe/construir-banco-unadista.mjs",
    "predev": "node scripts/sellar-repositorio.mjs && node scripts/zoe/construir-banco-unadista.mjs",
    "prebuild": "node scripts/sellar-repositorio.mjs && node scripts/zoe/construir-banco-unadista.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"scripts/*.mjs\" \"server/*.ts\" \"api/**/*.ts\" vite.config.ts vite-plugin-unad-gemini-proxy.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"scripts/*.mjs\" \"server/*.ts\" \"api/**/*.ts\" vite.config.ts vite-plugin-unad-gemini-proxy.ts"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@mintplex-labs/piper-tts-web": "1.0.5",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "docx": "^9.7.1",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.0",
    "onnxruntime-web": "1.18.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.174.0",
    "vite": "^6.2.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.174.0",
    "autoprefixer": "^10.4.21",
    "prettier": "3.3.3",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vitest": "^3.2.7"
  }
}
